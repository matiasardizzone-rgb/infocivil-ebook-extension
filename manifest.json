{
  "manifest_version": 3,
  "name": "PJN Descargador",
  "version": "0.9.0",
  "description": "Descarga, guarda localmente y visualiza documentos del Sistema de Consulta Web del PJN.",
  "action": {
    "default_title": "PJN Descargador",
    "default_popup": "src/public/popup.html"
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "tabs",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://scw.pjn.gov.ar/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://scw.pjn.gov.ar/*"
      ],
      "js": [
        "src/content/scw-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
